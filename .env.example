# docker-compose.yml publica Postgres en el puerto 5433 del host.
DATABASE_URL=postgresql://basecamp:basecamp@localhost:5433/basecamp
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-string
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001
# La API escucha API_PORT. Si no existe, usa PORT (Railway y Render lo inyectan).
API_PORT=3001
PORT=
# development en local. En producción tiene que ser production para la cookie Secure.
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=basecamp
S3_ACCESS_KEY=
S3_SECRET_KEY=
SEED_ADMIN_EMAIL=admin@basecamp.local
SEED_ADMIN_PASSWORD=change-me-now
SMS_RATE_LIMIT_PER_MINUTE=30
